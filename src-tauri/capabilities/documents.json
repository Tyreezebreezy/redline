{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "documents",
  "description": "REDLINE document persistence and close-flush access for the main window.",
  "windows": ["main"],
  "permissions": [
    "documents",
    "dictation",
    "transform",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-destroy"
  ]
}
