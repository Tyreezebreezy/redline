{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "REDLINE WebView2 Capture Probe",
  "version": "0.0.0",
  "identifier": "com.tyree.redline.webview2probe",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "REDLINE WebView2 Capture Probe",
        "width": 1040,
        "height": 820,
        "minWidth": 760,
        "minHeight": 620,
        "center": true
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "capabilities": [],
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "'none'",
        "font-src": "'self'",
        "form-action": "'none'",
        "frame-src": "'none'",
        "img-src": "'self' data:",
        "media-src": "'self' blob:",
        "object-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self'",
        "worker-src": "'self'"
      },
      "headers": {
        "Permissions-Policy": "microphone=(self), camera=()",
        "X-Content-Type-Options": "nosniff"
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../../../src-tauri/icons/icon.ico"]
  }
}
