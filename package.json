{
  "name": "redline",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "check": "pnpm typecheck && biome check . && pnpm test:foundation && pnpm test:editor && pnpm test:dictation && pnpm test:transform && pnpm test:humanizer && pnpm test:axiom && pnpm test:terminology && pnpm test:grammar-corpus && pnpm test:lexicon && pnpm test:clarity && pnpm test:persistence",
    "format": "biome format .",
    "format:write": "biome format --write .",
    "lint": "biome lint .",
    "preview": "vite preview",
    "test:foundation": "node scripts/check-foundation.mjs",
    "test:editor": "node scripts/check-editor.mjs",
    "test:dictation": "node scripts/check-dictation.mts",
    "test:transform": "node scripts/check-transform.mts",
    "test:humanizer": "node scripts/check-humanizer.mts",
    "test:axiom": "node scripts/check-axiom.mts",
    "test:terminology": "node scripts/generate-terminology.mts --check && node scripts/check-terminology.mts",
    "test:grammar-corpus": "node scripts/grammar-corpus.mts --self-test",
    "test:lexicon": "node scripts/generate-lexicon.mts --check && node scripts/check-lexicon.mts",
    "generate:lexicon": "node scripts/generate-lexicon.mts",
    "test:clarity": "node scripts/check-clarity.mts",
    "benchmark:axiom": "node scripts/benchmark-axiom.mts",
    "evaluate:grammar": "node scripts/grammar-corpus.mts",
    "benchmark:dictation": "cargo test --release --manifest-path src-tauri/Cargo.toml benchmark_dictation_corpus -- --ignored --nocapture",
    "benchmark:terminology": "node scripts/benchmark-terminology.mts",
    "generate:terminology": "node scripts/generate-terminology.mts",
    "benchmark:transform": "cargo test --release --manifest-path src-tauri/Cargo.toml benchmark_transform_corpus -- --ignored --nocapture --test-threads=1",
    "benchmark:humanizer": "cargo test --release --manifest-path src-tauri/Cargo.toml benchmark_humanizer_corpus -- --ignored --nocapture --test-threads=1",
    "package:transform-model": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/package-transform-model.ps1",
    "notices": "node scripts/generate-third-party-notices.mjs",
    "test:persistence": "cargo test --manifest-path src-tauri/Cargo.toml",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tiptap/extensions": "3.30.5",
    "@tiptap/pm": "3.30.5",
    "@tiptap/react": "3.30.5",
    "@tiptap/starter-kit": "3.30.5",
    "harper.js": "2.7.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  },
  "packageManager": "pnpm@11.16.0"
}
