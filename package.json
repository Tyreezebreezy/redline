{
  "name": "redline",
  "private": true,
  "version": "0.0.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "check": "pnpm typecheck && biome check . && pnpm test:foundation && pnpm test:editor && pnpm test:axiom && pnpm test:persistence",
    "format": "biome format .",
    "format:write": "biome format --write .",
    "lint": "biome lint .",
    "preview": "vite preview",
    "test:foundation": "node scripts/check-foundation.mjs",
    "test:editor": "node scripts/check-editor.mjs",
    "test:axiom": "node scripts/check-axiom.mts",
    "benchmark:axiom": "node scripts/benchmark-axiom.mts",
    "test:persistence": "cargo test --manifest-path src-tauri/Cargo.toml",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tiptap/extensions": "3.30.0",
    "@tiptap/pm": "3.30.0",
    "@tiptap/react": "3.30.0",
    "@tiptap/starter-kit": "3.30.0",
    "harper.js": "2.7.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  },
  "packageManager": "pnpm@11.16.0"
}
